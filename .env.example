# Forest Gastos — variables de entorno (copiar a .env, NO commitear .env)

# --- Supabase (frontend usa las VITE_*; funciones usan las sin prefijo) -------
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...        # solo backend, NUNCA al cliente

# --- Siigo Nube --------------------------------------------------------------
SIIGO_DRY_RUN=true                              # true = simula, no envía a Siigo
SIIGO_BASE_URL=https://api.siigo.com
SIIGO_PARTNER_ID=ForestGastos
SIIGO_USERNAME=                                 # correo de la credencial API
SIIGO_ACCESS_KEY=                               # Alianzas > Mi Credencial API
# Clasificación contable (DIFERIDA — la confirma el contador antes de push real):
SIIGO_DOCUMENT_TYPE_ID=                         # id de comprobante DS
SIIGO_COST_CENTER=                              # centro de costo

# --- Gmail API (notificaciones) ----------------------------------------------
EMAIL_DRY_RUN=true                              # true = registra, no envía
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=no-reply@forestcol.com

# --- Extracción con IA (DIFERIDA — Fase 0 híbrido) ---------------------------
EXTRACTION_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
